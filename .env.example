# ============================================================
# NSE Swing Scanner - Backend configuration
# Copy this file to ".env" and edit values as needed.
# NEVER commit the real ".env" file or real API keys.
# ============================================================

APP_ENV=development
LOG_LEVEL=INFO

# --- Database -------------------------------------------------
# SQLite file path (relative to backend/ working directory)
DATABASE_URL=sqlite:///./data/nse_scanner.db

# --- Stock universe --------------------------------------------

# --- Market data provider ---------------------------------------
# "mock"     -> deterministic synthetic OHLCV data, no network/API key needed.
# "yfinance" -> free delayed data via Yahoo Finance (unofficial, best-effort).
MARKET_DATA_PROVIDER=mock

# Optional API key for a future paid/real-time provider (NEVER sent to frontend).
MARKET_DATA_API_KEY=

# --- News provider -----------------------------------------------
# "mock" -> deterministic sample headlines clearly labeled as demo data.
# "rss"  -> free public Google News RSS per symbol (best-effort, unofficial).
NEWS_PROVIDER=mock
NEWS_API_KEY=

# --- Caching & rate limiting --------------------------------------
CACHE_TTL_SECONDS=900
RATE_LIMIT_MAX_CALLS=5
RATE_LIMIT_PERIOD_SECONDS=1
RATE_LIMIT_MAX_RETRIES=3

# --- Scheduler (automatic daily scan) ------------------------------
SCAN_TIMEZONE=Asia/Kolkata
SCAN_SCHEDULE_HOUR=16
SCAN_SCHEDULE_MINUTE=0
ENABLE_SCHEDULER=true

# --- Market hours (IST, local trading day) --------------------------
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30

# --- API / CORS -------------------------------------------------------
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
